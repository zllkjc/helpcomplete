{
  "name": "helpcomplete",
  "version": "0.1.0",
  "description": "Generic Bash/Zsh completion fallback that introspects `--help` output for CLIs without native completion.",
  "keywords": [
    "bash",
    "zsh",
    "completion",
    "autocomplete",
    "cli",
    "shell"
  ],
  "homepage": "https://github.com/zllkjc/helpcomplete#readme",
  "bugs": {
    "url": "https://github.com/zllkjc/helpcomplete/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zllkjc/helpcomplete.git"
  },
  "bin": {
    "helpcomplete": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p . && mkdir -p dist/templates && cp src/templates/*.tpl dist/templates/ && chmod +x dist/cli.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  },
  "license": "MIT"
}
